    <string name="onboarding_welcome_title">Save it. Use it.</string>
    <string name="onboarding_welcome_body">Caddis brings back what you save, when it fits. Then you finish it, let it go, or keep it for when you need it.</string>

    <string name="onboarding_save_title">Save from any app.</string>
    <string name="onboarding_save_body">Tap Share, then Caddis. That’s the whole job.</string>
    <string name="onboarding_save_tip">Not in the list? Tap More and pin Caddis.</string>

    <string name="onboarding_why_title">Say why you kept it.</string>
    <string name="onboarding_why_body">Caddis guesses from the page. Change it with one tap, or leave it.</string>
    <string name="onboarding_why_guess">Guessed from a recipe. Tap to change.</string>
    <string name="onboarding_why_foot">Nothing to file. Nothing to name.</string>

    <string name="onboarding_back_title">It comes back when it fits.</string>
    <string name="onboarding_back_body">Home shows three saves at most, picked for the day.</string>
    <string name="onboarding_back_foot">Cook saves return on weekend mornings. You can change every rule.</string>

    <string name="onboarding_finish_title">Finish it, or keep it.</string>
    <string name="onboarding_finish_body">Mark it done, let it go, or keep it for when you need it. No streaks, no guilt.</string>
    <string name="onboarding_finish_foot">Deleted saves wait 30 days in Trash. Kept saves wait in Library, under Kept.</string>

